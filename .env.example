# Copy this file to `.env` and fill in real values.
# `.env` itself is gitignored; this template is not, so never put real keys here.

# Kite Connect (https://developers.kite.trade) - paid plan required for
# live + historical market data, not just order placement.
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# For automated daily login (optional but recommended):
# 1. Enable 2FA on Kite, note the TOTP secret shown during setup
# 2. Get your user ID (email/phone used to login) and password
KITE_TOTP_SECRET=your_totp_secret_from_2fa_setup
KITE_USER_ID=your_kite_user_id
KITE_PASSWORD=your_kite_password
KITE_REDIRECT_URL=http://localhost

# OpenRouter (https://openrouter.ai) - free LLM API
OPENROUTER_API_KEY=your_openrouter_api_key

# Session/regime gates (the "when NOT to trade" layer)
# USE_SESSION_GATES=false
# SESSION_GATE_OPEN_MINUTE=585   # 09:45
# SESSION_GATE_CLOSE_MINUTE=870  # 14:30
# COST_COVER_MULTIPLE=3.0
# VOL_REGIME_LOW_PCTILE=0.20
# VOL_REGIME_HIGH_PCTILE=0.80
# GAP_MAX_PCT=0.02

# Risk / position sizing
# RISK_PER_TRADE_PCT=1.0
# ATR_STOP_MULTIPLIER=1.5
# REWARD_RISK_RATIO=2.0
# USE_TAKE_PROFIT=false
# USE_POSITION_SIZING=true
# MAX_POSITION_PCT_OF_CAPITAL=20.0
# TOTAL_RISK_BUDGET_PCT=6.0
# CORRELATION_LOOKBACK=500
# CORRELATION_THRESHOLD=0.6
# MAX_CLUSTER_EXPOSURE_PCT=20.0
# MAX_TOTAL_EXPOSURE_PCT=100.0
# VOLATILITY_RISK_CUTOFF=0.80
# VOLATILITY_RISK_FLOOR=0.50
# VOLATILITY_WINDOW_CANDLES=500

# Signal / backtest
# RSI_OVERSOLD=30
# RSI_OVERBOUGHT=70
# ADX_THRESHOLD=20
# PATTERN_CONFIRM_BUY_RSI=45
# PATTERN_CONFIRM_SELL_RSI=55
# MAX_CANDLE_AGE_MINUTES=10
# HEARTBEAT_MAX_AGE_SEC=60
# SLIPPAGE=0.0005
# FORWARD_WINDOW=6
# LOOKBACK_MIN=20
# SWING_ORDER=5

# Ingestion
# FLUSH_INTERVAL_SEC=5
# STALL_WARN_SEC=90
# FORCE_RECONNECT_SEC=300
# RECONNECT_MAX_TRIES=300
# RECONNECT_MAX_DELAY_SEC=30
# LARGE_WATCHLIST_THRESHOLD=100
# DEFAULT_INTERVAL=minute
# DEFAULT_DAYS_BACK=60

# Scheduler
# HEARTBEAT_TRUST_SEC=90
# FEED_DOWN_LOOKBACK_MIN=45
# MAX_WORKERS=4

# Logging
# LOG_LEVEL=INFO
# LOG_JSON=false
# LOG_FILE=debug.log

# API
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
