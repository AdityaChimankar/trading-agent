# Trading Agent Configuration
# Copy to .env and fill in your values

# Environment
ENVIRONMENT=development
DEBUG=false

# Database
DB_URL=sqlite:///data/trading.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Kite Connect API
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
KITE_ACCESS_TOKEN=your_access_token
KITE_REDIRECT_URL=http://localhost
KITE_USER_ID=your_user_id
KITE_PASSWORD=your_password
KITE_TOTP_SECRET=your_totp_secret

# Optional OpenAI-compatible decision path. Keep provider=mock to avoid calls.
# For OpenRouter, set LLM_BASE_URL=https://openrouter.ai/api.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Storage
STORAGE_PARQUET_ROOT=data/parquet
STORAGE_CANDLE_INTERVAL=5minute
STORAGE_COMPRESSION=snappy

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=1
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Machine Learning
ML_MODEL_DIR=models
ML_FEATURE_VERSION=v2
ML_RETRAIN_SCHEDULE=0 2 * * 1
ML_MIN_TRAIN_SAMPLES=1000
ML_CONFIDENCE_THRESHOLD=0.55

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=logs/trading-agent.log

# Data
DATA_DIR=data
CACHE_DIR=.cache
