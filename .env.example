# Trading Agent Configuration
# Copy to .env and fill in your values

# Environment
ENVIRONMENT=development
DEBUG=false

# Database
DB_URL=sqlite:///data/trading.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Kite Connect API
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
KITE_ACCESS_TOKEN=your_access_token
KITE_REDIRECT_URL=http://localhost
KITE_USER_ID=your_user_id
KITE_PASSWORD=your_password
KITE_TOTP_SECRET=your_totp_secret
KITE_LOGIN_HEADLESS=false

# LLM (news sentiment + LLM comparison agent) runs through OpenRouter.
# Keep provider=mock to make no calls. OPENROUTER_API_KEY is used when LLM_API_KEY is empty.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api
LLM_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.0-flash-001
# Optional tiers: a cheap model for headline sentiment and setup checks, a stronger one for
# decisions. Empty uses LLM_MODEL.
LLM_QUICK_MODEL=
LLM_DEEP_MODEL=
# Spacing between calls and retries on 429/5xx (Retry-After honoured).
LLM_MIN_INTERVAL_SECONDS=4.5
LLM_MAX_RETRIES=4

# Storage
STORAGE_PARQUET_ROOT=data/parquet
STORAGE_CANDLE_INTERVAL=5minute
STORAGE_COMPRESSION=snappy

# API Server
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
API_WORKERS=1
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional bearer token. Required before sharing access; never put it in VITE_*.
API_AUTH_TOKEN=

# Persistent paper ledger only; these settings do not enable broker orders.
PAPER_INITIAL_CAPITAL=1000000
PAPER_ENTRIES_ENABLED=true
PAPER_MAX_POSITIONS=10
PAPER_MAX_EXPOSURE_PCT=0.50
PAPER_MAX_RISK_PCT=0.06
PAPER_MAX_TRADE_RISK_PCT=0.02
# Fractions of realized paper equity; 0.10 = 10% per symbol.
PAPER_MAX_SINGLE_POSITION_PCT=0.10
# New entries stop at these realized-gross loss limits; exits remain available.
# A new entry is also refused when today's realized P&L, minus every open
# position's risk at its stop, minus the new trade's risk would pass the daily limit.
PAPER_MAX_DAILY_LOSS_PCT=0.03
PAPER_MAX_DRAWDOWN_PCT=0.15
# Refuse stops nearer than this fraction of the entry (0.0005 = 0.05%).
PAPER_MIN_STOP_DISTANCE_PCT=0.0005
# Refuse entries whose target is under this many stop distances from the entry price.
PAPER_MIN_REWARD_RISK=1.0

# Machine Learning
ML_MODEL_DIR=models
ML_FEATURE_VERSION=v2
ML_RETRAIN_SCHEDULE=0 2 * * 1
ML_MIN_TRAIN_SAMPLES=1000
ML_CONFIDENCE_THRESHOLD=0.55

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=logs/trading-agent.log

# Data
DATA_DIR=data
CACHE_DIR=.cache

# Intraday session discipline (IST). No entries after the cutoff; every open
# position is squared off at PAPER_SQUARE_OFF_TIME by the scheduler.
PAPER_MAX_TRADES_PER_DAY=20
PAPER_ENTRY_CUTOFF=15:00
PAPER_SQUARE_OFF_TIME=15:15
PAPER_ENFORCE_SESSION=true
# Block re-entering a symbol already traded today (after its stop or target).
PAPER_ONE_ENTRY_PER_SYMBOL_PER_DAY=false

# Order routing. Paper by default. Live Zerodha MARKET/MIS orders need BOTH
# EXECUTION_MODE=live and EXECUTION_LIVE_CONFIRMATION=I-ACCEPT-REAL-MONEY-RISK.
EXECUTION_MODE=paper
EXECUTION_LIVE_CONFIRMATION=
EXECUTION_SLIPPAGE_BPS=5
EXECUTION_PRODUCT=MIS
# Cap any position at this share of the stock's average daily traded value.
EXECUTION_MAX_PARTICIPATION_PCT=0.01
# ...and at this share of the volume still forecast to trade today.
EXECUTION_MAX_REMAINING_VOLUME_PCT=0.05
# Entry risk uses the worse of the plan price and the most recently ended stored
# bar (1-minute or the live interval) at most this old (seconds). Live entries
# are refused without one.
EXECUTION_MAX_QUOTE_AGE_SECONDS=900

# ML feature drift (PSI). ML is withdrawn when this many features exceed MONITOR_PSI_DRIFT.
MONITOR_PSI_WARN=0.1
MONITOR_PSI_DRIFT=0.25
MONITOR_DRIFT_FEATURES_TO_FALLBACK=3
